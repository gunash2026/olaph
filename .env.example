# Local infrastructure only. Never commit real secrets.
POSTGRES_DB=olaph
POSTGRES_USER=olaph_owner
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://olaph_runtime:replace@127.0.0.1:5432/olaph
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=replace-with-local-password
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production authentication, email, billing and object storage must be configured
# in the hosting provider's secret store, never NEXT_PUBLIC_*.
